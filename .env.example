# Passalong environment variables.
# Copy to .env and fill in real values. Never commit .env.
# Every secret here is server-side only and must never reach the browser.

# --- Yoto OAuth (from dashboard.yoto.dev) ---
# Public identifier for the app. Safe to send to the browser.
YOTO_CLIENT_ID=
# Confidential. Server-side only. Never commit, never expose to the client.
YOTO_CLIENT_SECRET=
# Must match the redirect URI registered at Yoto exactly.
YOTO_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Encryption at rest ---
# 32-byte key, base64-encoded, used to encrypt the Yoto refresh token before
# it is written to the database (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Session ---
# Secret for signing/encrypting the session cookie. Generate the same way.
SESSION_SECRET=

# --- Database ---
# Postgres connection string. Host-agnostic: any Postgres works. We use a
# Supabase project purely as a managed Postgres host (connection string only,
# no Supabase SDK/Auth). Dev and production use separate projects, so each
# environment's .env points at its own connection string. Prefer the pooled
# connection string (port 6543 on Supabase) for a serverless deployment.
DATABASE_URL=

# --- App ---
# Public base URL of this deployment. Used to build OAuth redirect URLs.
APP_BASE_URL=http://localhost:3000

# --- Scheduled jobs ---
# Shared secret the scheduler sends to /api/cron/* so only it can run jobs.
CRON_SECRET=
